{
    "name": "kylewlawrence/infinity-api-client-php",
    "type": "library",
    "description": "Infinity API PHP SDK",
    "minimum-stability": "stable",
    "keywords": [
        "infinity",
        "php-sdk",
        "guzzle"
    ],
    "homepage": "http://designanddevelop.io",
    "license": "MIT",
    "authors": [
        {
            "name": "KyleWLawrence",
            "email": "Kyle@DesignAndDevelop.io"
        }
    ],
    "require": {
        "doctrine/inflector": "^2.1.1",
        "guzzlehttp/guzzle": "^7.16 || ^8.3",
        "guzzlehttp/psr7": "^2.13 || ^3.2",
        "php": "^8.5",
        "ramsey/uuid": "^4.9.4"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "phpmd/phpmd": "^3.0.0",
        "phpunit/phpunit": "^13.4.5",
        "psy/psysh": "^0.12.24",
        "squizlabs/php_codesniffer": "^4.0.4"
    },
    "autoload": {
        "psr-4": {
            "KyleWLawrence\\Infinity\\Api\\": "src/Api",
            "KyleWLawrence\\Infinity\\Data\\": "src/Data",
            "KyleWLawrence\\Infinity\\Console\\": "src/Console"
        },
        "files": [
            "src/Data/Helpers.php"
        ]
    },
    "prefer-stable": true,
    "archive": {
        "exclude": [
            "/vendor",
            "/.history",
            "/.env",
            "/.env.*",
            "/composer.lock"
        ]
    }
}
